# ═══════════════════════════════════════════════════════════════════════════════
# ATM Beras — Raspberry Pi Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Salin file ini menjadi .env dan sesuaikan:
#   cp .env.example .env
#
# Hanya 2 field WAJIB diisi manual:
#   1. ATM_SERVER_URL  → URL server Laravel
#   2. ATM_MACHINE_CODE → Kode mesin (harus sudah terdaftar di Web Admin)
#
# Token & Machine ID akan terisi OTOMATIS saat pertama kali script dijalankan
# melalui mekanisme self-provisioning.
# ═══════════════════════════════════════════════════════════════════════════════

# URL server Laravel (wajib)
ATM_SERVER_URL=http://127.0.0.1:8000

# Kode mesin — harus sudah terdaftar oleh admin via Web Admin (wajib)
ATM_MACHINE_CODE=ATM-01

# ── OTOMATIS (jangan diisi manual) ────────────────────────────────────────────
# Token dan Machine ID di bawah ini akan diisi secara otomatis
# oleh script saat provisioning pertama kali.
ATM_TOKEN=
ATM_MACHINE_ID=

# ── OPSIONAL ──────────────────────────────────────────────────────────────────
# Port Flask lokal (default: 8765)
ATM_FLASK_PORT=8765

# Pin GPIO motor dispenser — BCM numbering (default: 18)
ATM_PIN_MOTOR=18

# Durasi motor per kg beras dalam detik (default: 3.0)
ATM_DETIK_PER_KG=3.0
